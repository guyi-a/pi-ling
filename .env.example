# Copy to `.env` in repo root, then run `pnpm dev` (loads this file automatically).

DEEPSEEK_API_KEY=

ANTHROPIC_API_KEY=

# Optional pi-ai route overrides.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 联网搜索（web_search 工具）。两把 key 任意配一把就能用；都空则不注册该工具。
# Tavily: 海外源为主，1000 次/月免费，注册 https://app.tavily.com
# Bocha:  国内源为主（中文覆盖好），1000 次试用，注册 https://open.bochaai.com
TAVILY_API_KEY=
BOCHA_API_KEY=

# DeepSeek Harness (ACP sidecar). First run: `pnpm dsh:setup` once.
PI_LING_DSH_ENABLED=false
# Packaged app: point at your pi-ling checkout (or set PI_LING_DSH_BIN directly).
# PI_LING_REPO_ROOT=E:/pi-ling
# Optional override; default is repo `.dsh-source/apps/cli/lib/bin.js`
# PI_LING_DSH_BIN=

# DeepSeek Codex (Agent engine via @openai/codex-sdk). Requires DEEPSEEK_API_KEY.
# Binary is bundled by `pnpm install` — no PI_LING_CODEX_BIN needed.
PI_LING_CODEX_ENABLED=false
# PI_LING_CODEX_HOME=

# Optional; defaults to the current Node executable.
# PI_LING_NODE_BIN=/absolute/path/to/node

{
  "name": "@pi-ling/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pi-ling desktop coding agent",
  "author": "pi-ling",
  "main": "./out/main/bootstrap.cjs",
  "scripts": {
    "generate-icon": "node scripts/generate-icon.mjs",
    "build": "pnpm --filter @pi-ling/dsh-runtime build && pnpm --filter @pi-ling/dsh-transcript build && node scripts/generate-icon.mjs && electron-vite build && node scripts/copy-bootstrap.mjs",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "dist": "pnpm run build && electron-builder --config electron-builder.yml",
    "dist:win": "pnpm run build && electron-builder --config electron-builder.yml --win --x64",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@earendil-works/pi-ai": "0.85.0",
    "@lezer/highlight": "^1.2.3",
    "@openai/codex": "0.154.0",
    "@pi-ling/codex-runtime": "workspace:*",
    "@pi-ling/coding-agent": "workspace:*",
    "@pi-ling/coding-eval": "workspace:*",
    "@pi-ling/compaction": "workspace:*",
    "@pi-ling/contracts": "workspace:*",
    "@pi-ling/dsh-runtime": "workspace:*",
    "@pi-ling/llm-config": "workspace:*",
    "@pi-ling/runtime-contracts": "workspace:*",
    "@pi-ling/session-events": "workspace:*",
    "@pi-ling/web-tools": "workspace:*",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.15",
    "katex": "^0.16.47",
    "lucide-react": "1.27.0",
    "node-pty": "^1.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "2.5.0",
    "zod": "4.5.4",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@openai/codex-darwin-arm64": "0.154.0-darwin-arm64",
    "@openai/codex-darwin-x64": "0.154.0-darwin-x64",
    "@openai/codex-linux-arm64": "0.154.0-linux-arm64",
    "@openai/codex-linux-x64": "0.154.0-linux-x64",
    "@openai/codex-win32-arm64": "0.154.0-win32-arm64",
    "@openai/codex-win32-x64": "0.154.0-win32-x64"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-mock-server": "link:../../.dsh-source/packages/test-support/llm-mock-server",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.1",
    "vitest": "4.1.9"
  }
}

{
  "name": "@pi-ling/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pi-ling desktop coding agent",
  "author": "pi-ling",
  "main": "./out/main/bootstrap.cjs",
  "scripts": {
    "build": "pnpm --filter @pi-ling/dsh-runtime build && pnpm --filter @pi-ling/dsh-transcript build && electron-vite build && node scripts/copy-bootstrap.mjs",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "dist": "pnpm run build && electron-builder --config electron-builder.yml",
    "dist:win": "pnpm run build && electron-builder --config electron-builder.yml --win --x64",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@earendil-works/pi-ai": "0.85.0",
    "@pi-ling/compaction": "workspace:*",
    "@pi-ling/coding-agent": "workspace:*",
    "@pi-ling/coding-eval": "workspace:*",
    "@pi-ling/contracts": "workspace:*",
    "@pi-ling/codex-runtime": "workspace:*",
    "@pi-ling/dsh-runtime": "workspace:*",
    "@pi-ling/runtime-contracts": "workspace:*",
    "@pi-ling/session-events": "workspace:*",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "docx-preview": "^0.4.0",
    "node-pty": "^1.0.0",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.3",
    "streamdown": "2.5.0",
    "zod": "4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-mock-server": "link:../../.dsh-source/packages/test-support/llm-mock-server",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.1",
    "vitest": "4.1.9"
  }
}
